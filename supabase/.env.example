# Server secrets only. Never copy this file's secrets into an APK or commit .env.
SWIGGY_AUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_FOOD_URL=https://mcp.swiggy.com/food
SWIGGY_CLIENT_ID=
SWIGGY_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/hungii-api/callback?forceFunctionRegion=ap-south-1
# Generate 32 random bytes, base64 encoded. Required for per-user token encryption.
HUNGII_TOKEN_KEY=
# Do not guess price units. Verify using approved staging responses before setting rupees or paise.
SWIGGY_PRICE_UNIT=unverified
# Keep false until approved staging confirms logical sessions across Edge workers.
SWIGGY_SESSION_RESUME_VERIFIED=false

# WorkOS staging application credentials; never include API keys in Android.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Issuer references the environment DEFAULT app, even for another app's JWT.
WORKOS_JWT_ISSUER=https://api.workos.com/user_management/YOUR_DEFAULT_CLIENT_ID

# Separate write gate. Keep false until the migration, production/staging access,
# price unit, session persistence and actual tools/list item schema are verified.
SWIGGY_ORDERING_ENABLED=false
SWIGGY_CART_CONTRACT_VERIFIED=false
# Fill ONLY from the approved simple-item contract; these are not mock defaults.
SWIGGY_CART_ITEM_ID_FIELD=
SWIGGY_CART_QUANTITY_FIELD=

# Never enable for production until Swiggy explicitly authorizes the integration.
SWIGGY_PRODUCTION_APPROVED=false
